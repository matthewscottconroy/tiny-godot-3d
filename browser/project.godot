; Engine configuration file.
; The demo browser. Kept out of the demo list itself — it has no project.godot
; sibling layout to teach, and the tools that walk the collection skip it by
; name rather than by accident.

config_version=5

[application]

config/name="3D Demo Browser"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=900
window/size/viewport_height=620

[rendering]

renderer/rendering_method="forward_plus"
